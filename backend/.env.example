# Plantilla de configuración. Cópiala a .env y captura los valores reales:
#     cp backend/.env.example backend/.env
# El archivo .env no se versiona: trae las credenciales del servidor.

PORT=3080

# ---------------------------------------------------------------------
# PostgreSQL: el servidor local ~/docker/postgres-bd. En desarrollo, docker-compose.yml fuerza
# DB_HOST=pg (su nombre dentro de la red postgres-bd-red). DBeaver usa localhost:5432.
# ---------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=sigenom
DB_PASSWORD=sigenom-local
DB_DATABASE=sigenom

# ---------------------------------------------------------------------
# Redis: solo guarda la cola de cálculos (BullMQ), no datos de nómina.
# ---------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# Cuántos empleados procesa cada worker antes de guardar avance, y cuántos cálculos atiende a la vez.
WORKER_LOTE=250
WORKER_CONCURRENCIA=2

# Secreto de firma del token. Genéralo con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=28800

# Usuario inicial que crea "npm run seed" (rol administrador). Cámbiale la contraseña al entrar.
SEED_ADMIN_USUARIO=ADMIN
SEED_ADMIN_PASSWORD=
# true: el seed también carga empleados y una quincena de ejemplo. Nunca en producción.
SEED_DATOS_EJEMPLO=true

# ---------------------------------------------------------------------
# Otros sistemas: de dónde se traen los movimientos. Ver docs/integraciones.md.
# Personal va por la API de SIModpersonal: LLAVE es la misma que su NOMINA_API_KEY.
# Checadores y Préstamos se leen de PostgreSQL. Sin HOST o BASE (o sin URL y LLAVE), ese sistema aparece como "sin conectar". Usa un usuario que solo pueda leer.
# ---------------------------------------------------------------------
EXT_PERSONAL_URL=
EXT_PERSONAL_LLAVE=
EXT_CHECADOR_HOST=
EXT_CHECADOR_PORT=5432
EXT_CHECADOR_BASE=
EXT_CHECADOR_USUARIO=
EXT_CHECADOR_PASSWORD=
EXT_PRESTAMOS_HOST=
EXT_PRESTAMOS_PORT=5432
EXT_PRESTAMOS_BASE=
EXT_PRESTAMOS_USUARIO=
EXT_PRESTAMOS_PASSWORD=

# ---------------------------------------------------------------------
# Consulta de capacidad de descuento para otros sistemas (docs/api-capacidad-descuento.md).
# Llave que mandan en x-api-key; al menos 32 caracteres: openssl rand -hex 32. Vacía: la consulta no responde.
# ---------------------------------------------------------------------
CONSULTA_API_LLAVE=

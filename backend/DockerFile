# Una sola imagen para la API y el worker; cambia solo el comando (dist/main.js o dist/worker.js).

# Etapa de compilación
FROM node:24-alpine AS build

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

RUN npm run build

# Etapa de producción
FROM node:24-alpine AS production

WORKDIR /app

ENV NODE_ENV=production
ENV TZ=America/Mexico_City

COPY package*.json ./

# Se instalan también las devDependencies porque sequelize-cli (migrate/seed) se ejecuta dentro de
# este contenedor con "docker compose exec backend npm run migrate".
RUN npm ci --include=dev

COPY --from=build /app/dist ./dist

# sequelize-cli no lee dist/: resuelve migraciones y seeders desde src/database.
COPY --from=build /app/src/database ./src/database
COPY --from=build /app/.sequelizerc ./.sequelizerc

EXPOSE 3080

CMD ["node", "dist/main.js"]
